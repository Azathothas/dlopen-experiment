+// ---------------------------------------------------------------------------
+// Host library search path (Design P)
+//
+// Anylinux patches ld-linux.so to skip /etc/ld.so.cache, because reading it
+// segfaults instantly on some systems (HALL-OF-FAME.md, issue #766). With the
+// cache gone, --library-path is the ONLY discovery mechanism there is, and
+// anything it omits is invisible even though the host's own loader would find
+// it.
+//
+// Measured across alpine 3.22, debian bullseye/trixie, ubuntu 20.04, rocky 9,
+// fedora 44, opensuse tumbleweed and arch:
+//
+//   /usr/local/lib             present on ALL EIGHT, absent from the old list
+//   /usr/local/lib64           present on rocky, fedora, opensuse
+//   /usr/local/lib/<triplet>   in ld.so.conf.d on debian and ubuntu
+//   /usr/libexec               present on debian, ubuntu, rocky, fedora, suse
+//   /etc/ld.so.conf{,.d}       the distro's own authoritative answer; plain
+//                              text, so reading it is safe -- this gets the
+//                              benefit of the cache without touching the
+//                              binary cache that caused the segfault
+//
+// Everything here is a FALLBACK: appended after the bundled directories, never
+// before, so bundled libraries keep winning.
+// ---------------------------------------------------------------------------
+
+// Read one ld.so.conf-style file, following `include` globs.
+// Bounded recursion: a self-including conf must not hang the launcher.
+fn parse_ld_so_conf(path: &Path, out: &mut Vec<String>, depth: u32) {
+    if depth > 4 { return }
+    let text = match read_to_string(path) { Ok(t) => t, Err(_) => return };
+    for line in text.lines() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        if line.is_empty() { continue }
+        if let Some(rest) = line.strip_prefix("include") {
+            let pat = rest.trim();
+            if pat.is_empty() { continue }
+            // A relative include resolves against the containing directory.
+            let pat = if pat.starts_with('/') {
+                pat.to_string()
+            } else {
+                format!("{}/{pat}", path.parent().unwrap_or(Path::new("/etc")).display())
+            };
+            // Only the trailing-* form occurs in practice (*.conf); handling
+            // it by hand keeps this dependency-free.
+            let (dir, suffix) = match pat.rfind('/') {
+                Some(i) => (pat[..i].to_string(), pat[i + 1..].to_string()),
+                None => continue
+            };
+            let suffix = suffix.trim_start_matches('*').to_string();
+            if let Ok(entries) = std::fs::read_dir(&dir) {
+                for entry in entries.flatten() {
+                    let name = entry.file_name();
+                    let name = name.to_string_lossy();
+                    if suffix.is_empty() || name.ends_with(&suffix) {
+                        parse_ld_so_conf(&entry.path(), out, depth + 1)
+                    }
+                }
+            }
+        } else {
+            out.push(line.to_string())
+        }
+    }
+}
+
+// Every host directory worth searching, most specific first.
+fn host_library_dirs(is_elf32_bin: bool) -> Vec<String> {
+    let mut dirs: Vec<String> = Vec::new();
+
+    // 1. The distro's own answer, when it has one. Authoritative and cheap.
+    parse_ld_so_conf(Path::new("/etc/ld.so.conf"), &mut dirs, 0);
+
+    // 2. musl hosts have no ld.so.conf; they have this, and a built-in default
+    //    of /lib:/usr/local/lib:/usr/lib when the file is absent -- measured:
+    //    Alpine 3.22 ships no such file at all, so the defaults below matter.
+    for arch in ["x86_64", "aarch64", "i386", "riscv64", "armhf"] {
+        parse_ld_so_conf(Path::new(&format!("/etc/ld-musl-{arch}.path")), &mut dirs, 0)
+    }
+
+    // 3. /usr/local/*, present on every distro surveyed and missing from the
+    //    hardcoded list this replaces. This is the concrete bug E13b shows.
+    dirs.push("/usr/local/lib".into());
+    if is_elf32_bin {
+        dirs.push("/usr/local/lib32".into());
+        dirs.push("/usr/lib32".into());
+        dirs.push("/lib32".into());
+    } else {
+        dirs.push("/usr/local/lib64".into());
+    }
+
+    // 4. Multiarch triplets. Only x86-64/i386/aarch64 were handled, so a
+    //    riscv64 or ppc64le host silently lost its entire multiarch directory.
+    let triplets: &[&str] = if is_elf32_bin {
+        &["i386-linux-gnu", "arm-linux-gnueabihf"]
+    } else {
+        &["x86_64-linux-gnu", "aarch64-linux-gnu", "riscv64-linux-gnu",
+          "powerpc64le-linux-gnu", "s390x-linux-gnu", "loongarch64-linux-gnu"]
+    };
+    for t in triplets {
+        dirs.push(format!("/usr/local/lib/{t}"));
+        dirs.push(format!("/lib/{t}"));
+        dirs.push(format!("/usr/lib/{t}"));
+    }
+
+    // 5. The FHS baseline.
+    dirs.push("/usr/lib".into());
+    dirs.push("/lib".into());
+    if !is_elf32_bin {
+        dirs.push("/usr/lib64".into());
+        dirs.push("/lib64".into());
+    }
+    dirs.push("/usr/libexec".into());
+
+    // 6. Non-FHS prefixes. NixOS was already handled; these were not.
+    dirs.push("/run/opengl-driver/lib".into());
+    dirs.push("/run/current-system/sw/lib".into());
+    dirs.push("/run/current-system/profile/lib".into());        // Guix
+    dirs.push("/app/lib".into());                                // Flatpak
+    dirs.push("/data/data/com.termux/files/usr/lib".into());     // Termux
+
+    // Deduplicate and drop what does not exist. Every surviving entry costs a
+    // stat per lookup per miss, so a bloated path is a measurable startup
+    // cost, not just untidiness.
+    let mut seen: std::collections::HashSet<String> = std::collections::HashSet::new();
+    dirs.retain(|d| {
+        let d = d.trim_end_matches('/');
+        !d.is_empty() && seen.insert(d.to_string()) && is_dir(d)
+    });
+    dirs
+}
